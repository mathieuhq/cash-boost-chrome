# Cash Boost backend — copy to .env for `pnpm dev` (on Vercel: Project → Settings → Environment Variables).

# Public base URL of this backend, without trailing slash (prod: https://<projet>.vercel.app or your domain).
BETTER_AUTH_URL=http://localhost:8787
# Random secret, ≥ 32 chars: signs sessions, bearer tokens and cookies. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud → Clients → Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chrome extension ids (32 letters a-p), comma-separated: trusted origins, CORS, allowed sign-in redirects.
EXTENSION_IDS=
# Emails promoted to role admin at sign-in (access to /admin), comma-separated.
ADMIN_EMAILS=

# Neon Postgres URL (Vercel Marketplace). Empty in local dev → PGlite file database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# OpenRouter key (sk-or-…) for Jev; never sent to the extension.
OPENROUTER_API_KEY=
# Pinned Jev version (thresholds are tuned against it).
JEV_MODEL=typesafe/jev-1.13

# LearnHouse (student check). API token lh_… with users.read + usergroups.read.
LEARNHOUSE_URL=https://learn.example.com
LEARNHOUSE_API_TOKEN=
LEARNHOUSE_ORG_SLUG=my-school
# Growth Boost user group UUID(s), comma-separated: a member of any of them is a student.
LEARNHOUSE_GROUP_UUIDS=

# Resend: emails the student link code. Domain mail.example.com verified in Resend.
# Empty in local dev → the code is printed in the backend console.
RESEND_API_KEY=
MAIL_FROM=Cash Boost <contact@mail.example.com>

# Stripe: secret key, webhook signing secret (whsec_…) and the one-time Price id (price_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Local dev port.
PORT=8787
