{
  "name": "@super-x/extension",
  "displayName": "Cash Boost",
  "version": "0.1.0",
  "description": "Livre tes lead magnets en DM pendant que tu postes sur X.",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i src/style.css -o src/style.generated.css",
    "dev": "pnpm css && (pnpm css --watch=always & plasmo dev)",
    "build": "pnpm css --minify && plasmo build",
    "package": "pnpm build && plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "key": "node scripts/extension-key.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@super-x/adapters-backend": "workspace:*",
    "@super-x/adapters-chrome": "workspace:*",
    "@super-x/adapters-x": "workspace:*",
    "@super-x/application": "workspace:*",
    "@super-x/contracts": "workspace:*",
    "@super-x/domain": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "plasmo": "0.90.5",
    "radix-ui": "1.6.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/chrome": "0.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "manifest": {
    "key": "$CRX_PUBLIC_KEY",
    "permissions": [
      "sidePanel",
      "storage",
      "unlimitedStorage",
      "alarms",
      "scripting",
      "identity"
    ],
    "host_permissions": [
      "https://x.com/*",
      "$PLASMO_PUBLIC_BACKEND_URL/*"
    ]
  }
}
