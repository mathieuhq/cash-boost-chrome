# Copy to .env.development (pnpm dev) and .env.production (pnpm build), then fill in.

# Backend (apps/backend). Local dev: http://localhost:8787
PLASMO_PUBLIC_BACKEND_URL=http://localhost:8787
# Fixed extension ID: run `pnpm key` and paste its CRX_PUBLIC_KEY line here.
# For the Chrome Web Store build, use the public key shown in the store dashboard instead.
CRX_PUBLIC_KEY=
