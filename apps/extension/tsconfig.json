{
  "extends": "plasmo/templates/tsconfig.base",
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "build"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  }
}
